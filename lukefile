luke_format = 0

package  = 'typecheck'
version  = '$USER'

ldocs    = 'build-aux/config.ld.in'

modules  = {
   {['typecheck']         = 'lib/typecheck/init.lua'},
   {['typecheck.version'] = 'lib/typecheck/version.lua.in'},
}

release  = {
   news               = 'NEWS.md',
   rockspec           = 'typecheck-dev-1.rockspec',
   check_dependencies = true,
   add                = {'doc/'},
   replacements       = {
      {['README.md']  = {
         {['?branch=master'] = '?branch=release-v@version@'},
      }},
   },
   ['gh-pages']       = {
      {['.'] = 'doc/'},
   },
}
